{
  "$schema": "brand/BRAND.md is the canon; this file mirrors it for tooling.",
  "name": "uNotch",
  "tagline": "Live AI usage, quietly tucked into the edge of your Mac.",
  "colors": {
    "charcoal": "#15191B",
    "graphite": "#1E2427",
    "ash": "#2A3135",
