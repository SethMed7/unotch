    "smoke": "#8B9498",
    "paper": "#F4F7F6",
    "mint": "#3BE29B",
    "backdropGround": "#B7C9C1"
  },
  "backdrop": {
    "source": "Aetheria render, emerald flow, seed 805214",
    "url": "https://aetheria.sethmedina.com",
    "files": "site/assets/aetheria-emerald-805214-{960,1440,2048}.webp",
